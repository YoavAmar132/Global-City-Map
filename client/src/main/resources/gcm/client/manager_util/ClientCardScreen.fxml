<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.manager_util.ClientCardController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <!-- Close (X) button -->
    <Button text="✕"
            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18; -fx-cursor: hand;"
            onAction="#handleClose"
            AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>

    <!-- Center card -->
    <StackPane AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="40.0"
               AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0"
               style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <effect>
            <DropShadow radius="10.0" color="#00000055"/>
        </effect>

        <VBox spacing="14.0" prefWidth="720.0" alignment="TOP_CENTER">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <!-- Title -->
            <Text text="client card" fill="white">
                <font>
                    <Font name="Segoe UI Semibold" size="28.0"/>
                </font>
            </Text>

            <Label text="Client details and purchase history"
                   textFill="white"
                   style="-fx-font-size: 13; -fx-opacity: 0.9;"/>

            <!-- Actions -->
            <HBox spacing="10.0" alignment="CENTER">
                <Button fx:id="refreshButton" text="Refresh"
                        prefWidth="120.0" prefHeight="32.0"
                        style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                        onAction="#onRefreshClicked"/>

                <Button fx:id="backButton" text="Back"
                        prefWidth="120.0" prefHeight="32.0"
                        style="-fx-background-color: rgba(255,255,255,0.20); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                        onAction="#onBackClicked"/>
                <Button fx:id="ChangeInfoButton" text="Change info"
                        prefWidth="120.0" prefHeight="32.0"
                        style="-fx-background-color: rgba(255,255,255,0.20); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                        onAction="#onChangeInfo"/>
            </HBox>

            <!-- Client info -->
            <VBox spacing="10.0" prefWidth="760.0"
                  style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 12;">
                <padding>
                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                </padding>

                <!-- Row 1 -->
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="Username:"
                           textFill="white"
                           style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblUsername" text="—"
                           textFill="white"
                           style="-fx-font-size: 14;"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label text="Phone:"
                           textFill="white"
                           style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblPhone" text="—"
                           textFill="white"
                           style="-fx-font-size: 14;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Role:"
                       textFill="white"
                       style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                <Label fx:id="lblRole" text=""
                       textFill="white"
                       style="-fx-font-size: 14;"/>
            </HBox>

                <!-- Row 2 -->
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="First name:"
                           textFill="white"
                           style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblFirstName" text="—"
                           textFill="white"
                           style="-fx-font-size: 14;"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label text="Surname:"
                           textFill="white"
                           style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblSurname" text="—"
                           textFill="white"
                           style="-fx-font-size: 14;"/>
                    <HBox HBox.hgrow="ALWAYS"/>

                    <Label text="Email:"
                           textFill="white"
                           style="-fx-font-size: 14; -fx-opacity: 0.9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblemail" text="—"
                           textFill="white"
                           style="-fx-font-size: 14;"/>
                </HBox>
            </VBox>

            <!-- Purchase history -->
            <VBox spacing="8.0" prefWidth="760.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 12;">
                <padding>
                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                </padding>

                <Label text="Purchase History"
                       textFill="white"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-opacity: 0.95;"/>

                <TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-control-inner-background: rgba(20,30,48,0.55); -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colPurchase" text="Record" prefWidth="730.0"/>
                    </columns>
                </TableView>

                <Label fx:id="statusLabel"
                       text="Loading purchase history..."
                       textFill="white"
                       style="-fx-font-size: 12; -fx-opacity: 0.85;"/>
            </VBox>

        </VBox>
    </StackPane>
</AnchorPane>
