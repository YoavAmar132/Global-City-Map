<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.map.MapOverlayLayerController"
            style="-fx-background-color: transparent;"
            pickOnBounds="false"
            mouseTransparent="true">
    <!--
        mouseTransparent="true" → by default, overlay lets mouse pass THROUGH
        pickOnBounds="false"    → empty areas are not clickable at all
        We'll re-enable mouse only on the actual POI nodes.
    -->

    <!-- Routes: drawn visually, but never block mouse -->
    <Pane fx:id="routeLayer"
          style="-fx-background-color: transparent;"
          pickOnBounds="false" />

    <!-- POIs: their own nodes will turn mouse back on -->
    <Pane fx:id="poiLayer"
          style="-fx-background-color: transparent;"
          pickOnBounds="false" />
</AnchorPane>
