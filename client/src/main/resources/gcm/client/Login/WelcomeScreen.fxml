<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.WelcomeController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <!-- Close (X) button -->
    <Button text="✕"
            style="-fx-background-color: transparent; -fx-text-fill: black; -fx-font-size: 18;"
            onAction="#handleClose"
            AnchorPane.rightAnchor="10.0"
            AnchorPane.topAnchor="10.0"/>

    <!-- Center card -->
    <StackPane prefWidth="400.0" prefHeight="260.0"
               layoutX="100.0" layoutY="70.0"
               style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <effect>
            <DropShadow radius="10.0" color="#00000055"/>
        </effect>

        <VBox alignment="CENTER" spacing="20.0" prefWidth="300.0">

            <!-- Title -->
            <Text text="Global City Map" fill="white">
                <font>
                    <Font name="Segoe UI Semibold" size="30.0"/>
                </font>
            </Text>

            <!-- Subtitle -->
            <Text text="Welcome!" fill="white">
                <font>
                    <Font name="Segoe UI" size="18.0"/>
                </font>
            </Text>

            <!-- View Catalog -->
            <Button text="View Catalog"
                    prefWidth="200.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                    onAction="#onViewCatalog"/>

            <!-- Login / Register -->
            <Button text="Login / Register"
                    prefWidth="200.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                    onAction="#onLogin"/>

        </VBox>
    </StackPane>

</AnchorPane>
