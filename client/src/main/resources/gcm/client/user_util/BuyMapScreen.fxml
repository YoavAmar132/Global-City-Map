<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.Group?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.user_util.BuyMapScreenController"
            prefHeight="500.0" prefWidth="820.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Group StackPane.alignment="TOP_RIGHT">
            <!-- Return (↷) button -->
            <Button text="&#x21b7;"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 26; -fx-cursor: hand;"
                    onAction="#handleClose"
                    AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>
        </Group>

        <Group StackPane.alignment="CENTER">
            <StackPane layoutX="210.0" layoutY="80.0"
                       prefWidth="400.0" prefHeight="340.0"
                       style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
                <effect>
                    <DropShadow radius="10.0" color="#00000055"/>
                </effect>

                <VBox spacing="15.0" alignment="CENTER">
                    <padding>
                        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
                    </padding>

                    <fx:define>
                        <ToggleGroup fx:id="purchaseGroup"/>
                    </fx:define>

                    <Text text="Confirm Purchase" fill="white">
                        <font>
                            <Font name="Segoe UI Semibold" size="24.0"/>
                        </font>
                    </Text>

                    <Label fx:id="cityNameLabel" text="City Name" textFill="white">
                        <font><Font size="20.0"/></font>
                    </Label>

                    <VBox spacing="10.0" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 10; -fx-padding: 15;">

                        <Label text="Select Plan:" textFill="#cccccc" style="-fx-font-size: 12;"/>

                        <RadioButton fx:id="radioOTP" text="One Time Purchase" textFill="white" selected="true" toggleGroup="$purchaseGroup">
                            <font><Font size="14.0"/></font>
                        </RadioButton>

                        <Label text="    Lifetime access to this version." textFill="#aaaaaa" style="-fx-font-size: 11;"/>

                        <RadioButton fx:id="radioSub" text="Subscription (6 Months)" textFill="white" toggleGroup="$purchaseGroup">
                            <font><Font size="14.0"/></font>
                        </RadioButton>

                        <Label text="    Access to all updates for 6 months." textFill="#aaaaaa" style="-fx-font-size: 11;"/>

                    </VBox>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label text="Total:" textFill="white" style="-fx-font-size: 16;"/>
                        <Label fx:id="priceLabel" text="0.00" textFill="#4cd137">
                            <font><Font name="System Bold" size="22.0"/></font>
                        </Label>
                    </HBox>

                    <HBox spacing="15.0" alignment="CENTER">
                        <Button text="Cancel"
                                prefWidth="100.0" prefHeight="35.0"
                                style="-fx-background-color: rgba(255,255,255,0.20); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                                onAction="#onCancelClicked"/>

                        <Button text="Checkout"
                                prefWidth="100.0" prefHeight="35.0"
                                style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                                onAction="#onConfirmPurchaseClicked"/>
                    </HBox>
                </VBox>
            </StackPane>
        </Group>
    </StackPane>


</AnchorPane>