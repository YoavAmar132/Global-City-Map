<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="gcm.client.controllers.user_util.BuyMapController"
           prefHeight="500.0" prefWidth="700.0"
           style="-fx-background-color: #1d2a3d;">

    <VBox alignment="CENTER" spacing="25" maxWidth="400" maxHeight="380"
          style="-fx-background-color: #3b4657; -fx-background-radius: 20; -fx-padding: 40;">

        <effect>
            <DropShadow color="#00000066" radius="20" spread="0.1"/>
        </effect>

        <Label text="Purchase Options" textFill="WHITE">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Label text="Select a plan below" textFill="#b0b5bd">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <Region prefHeight="10" />

        <VBox spacing="20" alignment="CENTER_LEFT" maxWidth="300">
            <RadioButton fx:id="oneTimePurchaseRadio" text="One Time Purchase"
                         textFill="WHITE" style="-fx-font-size: 15px; -fx-cursor: hand;"/>

            <RadioButton fx:id="subscriptionRadio" text="Subscription (Add more cities)"
                         textFill="WHITE" style="-fx-font-size: 15px; -fx-cursor: hand;"/>
        </VBox>

        <Region prefHeight="20" />

        <Button fx:id="nextButton" text="Next" onAction="#handleNext"
                prefWidth="280" prefHeight="45"
                style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000040" radius="5" offsetY="3"/>
            </effect>
        </Button>

    </VBox>
</StackPane>