<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="gcm.client.controllers.user_util.PaymentController"
           prefHeight="500.0" prefWidth="700.0"
           style="-fx-background-color: #1d2a3d;">

    <VBox alignment="CENTER" spacing="20" maxWidth="400" maxHeight="300"
          style="-fx-background-color: #3b4657; -fx-background-radius: 20; -fx-padding: 30;">

        <effect>
            <DropShadow color="#00000066" radius="20" spread="0.1"/>
        </effect>

        <Label text="Confirm Purchase" textFill="WHITE">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>

        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #2c3542; -fx-padding: 15; -fx-background-radius: 10;">
            <Label fx:id="itemLabel" text="City: Braavos" textFill="#b0b5bd" style="-fx-font-size: 16px;"/>
            <Label fx:id="priceLabel" text="90.0" textFill="#00c6ff" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>

        <Label text="Payment will be charged to your card on file." textFill="#b0b5bd" wrapText="true"/>

        <Region prefHeight="10" />

        <Button text="Pay Now" onAction="#handleBuy"
                prefWidth="250" prefHeight="45"
                style="-fx-background-color: #00c6ff; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000040" radius="5" offsetY="3"/>
            </effect>
        </Button>

    </VBox>
</StackPane>