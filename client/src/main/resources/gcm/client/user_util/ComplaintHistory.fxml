<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.user_util.ComplaintHistoryController"
            prefHeight="500.0" prefWidth="820.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">


    <Button text="&#x21b7;"
        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 26; -fx-cursor: hand;"
        onAction="#handleClose"
        AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>

    <StackPane  alignment="TOP_CENTER"
                layoutX="80.0" layoutY="60.0"
               prefWidth="660.0" prefHeight="380.0"
               style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <effect>
            <DropShadow radius="10.0" color="#00000055"/>
        </effect>

        <VBox spacing="14.0" prefWidth="620.0" prefHeight="340.0" alignment="TOP_CENTER">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Text text="You previous complaints" fill="white">
                <font>
                    <Font name="Segoe UI Semibold" size="28.0"/>
                </font>
            </Text>

            <Label text="Select a complaint to view it"
                   textFill="white"
                   style="-fx-font-size: 13; -fx-opacity: 0.9;"/>

            <HBox spacing="10.0" alignment="CENTER">
                <Button text="Create new complaint"
                        prefWidth="160.0" prefHeight="32.0"
                        style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 8; -fx-cursor: hand;"
                        onAction="#onCreateComplaintClicked"/>
            </HBox>

            <ScrollPane fitToWidth="true"
                        prefWidth="620.0" prefHeight="250.0"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox fx:id="complaintList" spacing="10.0">
                        <padding>
                            <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

            <Label fx:id="statusLabel"
               text="Loading complaints..."
               textFill="white"
               style="-fx-font-size: 12; -fx-opacity: 0.85;"/>
        </VBox>
    </StackPane>
</AnchorPane>