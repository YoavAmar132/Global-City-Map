<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.Group?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.City.DeleteRouteController"
            prefHeight="500.0" prefWidth="820.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <!-- Close button -->


    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Group StackPane.alignment="TOP_RIGHT">
            <!-- Return (↷) button -->
            <Button text="&#x21b7;"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 26; -fx-cursor: hand;"
                    onAction="#onBack"
                    AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>
        </Group>

        <Group StackPane.alignment="CENTER">
            <!-- Center card -->
            <StackPane AnchorPane.topAnchor="60"
                       AnchorPane.leftAnchor="80"
                       AnchorPane.rightAnchor="80"
                       AnchorPane.bottomAnchor="60"
                       style="-fx-background-color: rgba(255,255,255,0.15);
                      -fx-background-radius: 16;">
                <effect>
                    <DropShadow radius="10" color="#00000055"/>
                </effect>

                <VBox spacing="14" alignment="TOP_CENTER" prefWidth="620">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Title -->
                    <Text text="Delete Routes" fill="white">
                        <font>
                            <Font name="Segoe UI Semibold" size="28"/>
                        </font>
                    </Text>

                    <Label text="Select a route and delete it permanently"
                           textFill="white"
                           style="-fx-font-size: 13; -fx-opacity: 0.85;"/>

                    <!-- Action buttons -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Refresh"
                                prefWidth="120" prefHeight="32"
                                onAction="#onRefresh"
                                style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                        <Button text="Back"
                                prefWidth="120" prefHeight="32"
                                onAction="#onBack"
                                style="-fx-background-color: rgba(255,255,255,0.20);
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
                    </HBox>

                    <!-- List -->
                    <ScrollPane fitToWidth="true"
                                prefHeight="260"
                                hbarPolicy="NEVER"
                                style="-fx-background: transparent;
                               -fx-background-color: transparent;
                               -fx-border-color: transparent;">
                        <content>
                            <VBox fx:id="listBox" spacing="10">
                                <padding>
                                    <Insets top="8" right="8" bottom="8" left="8"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <!-- Status -->
                    <Label fx:id="statusLabel"
                           text="Loading routes..."
                           textFill="white"
                           style="-fx-font-size: 12; -fx-opacity: 0.8;"/>

                </VBox>
            </StackPane>
        </Group>
    </StackPane>


</AnchorPane>
