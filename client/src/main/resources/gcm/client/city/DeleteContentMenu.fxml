<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.City.DeleteContentMenuController"
            prefWidth="500"
            prefHeight="350"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <Button text="✕"
            onAction="#handleClose"
            AnchorPane.topAnchor="16"
            AnchorPane.rightAnchor="16"
            style="-fx-background-color: transparent;
                   -fx-text-fill: white;
                   -fx-font-size: 18;
                   -fx-cursor: hand;" />

    <VBox spacing="30"
          alignment="CENTER"
          AnchorPane.topAnchor="40"
          AnchorPane.leftAnchor="40"
          AnchorPane.rightAnchor="40"
          AnchorPane.bottomAnchor="40">

        <Label text="Delete Content"
               style="-fx-text-fill: white;">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Button text="Delete POI"
                onAction="#onDeletePoi"
                style="-fx-background-color: #ff6b6b;
                       -fx-text-fill: white;
                       -fx-font-size: 16;
                       -fx-background-radius: 8;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;" />

        <Button text="Delete Map"
                onAction="#onDeleteMap"
                style="-fx-background-color: #ffa502;
                       -fx-text-fill: white;
                       -fx-font-size: 16;
                       -fx-background-radius: 8;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;" />

        <Button text="Delete Route"
                onAction="#onDeleteRoute"
                style="-fx-background-color: #1e90ff;
                       -fx-text-fill: white;
                       -fx-font-size: 16;
                       -fx-background-radius: 8;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;" />

    </VBox>
</AnchorPane>
