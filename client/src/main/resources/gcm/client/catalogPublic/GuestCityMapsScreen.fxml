<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Group?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.catalogPublic.GuestCityMapsController"
            prefWidth="820"
            prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <StackPane AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.topAnchor="0.0"
               AnchorPane.rightAnchor="0.0">

        <!-- Return button -->
        <Group StackPane.alignment="TOP_RIGHT">
            <Button text="&#x21b7;"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 26;
                           -fx-cursor: hand;"
                    onAction="#handleClose"
                    AnchorPane.rightAnchor="10.0"
                    AnchorPane.topAnchor="10.0"/>
        </Group>

        <Group StackPane.alignment="CENTER">

            <!-- Center card -->
            <StackPane prefWidth="660"
                       prefHeight="380"
                       style="-fx-background-color: rgba(255,255,255,0.15);
                              -fx-background-radius: 16;">

                <VBox spacing="14"
                      prefWidth="620"
                      prefHeight="340"
                      alignment="TOP_CENTER">

                    <!-- Title -->
                    <Label fx:id="titleLabel"
                           style="-fx-text-fill: white;">
                        <font>
                            <Font size="28"/>
                        </font>
                    </Label>

                    <!-- Search bar (SAME AS CITY CATALOG) -->
                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <TextField fx:id="searchField"
                                   promptText="Search by map name or description..."
                                   HBox.hgrow="ALWAYS"
                                   style="
                                       -fx-background-radius: 8;
                                       -fx-padding: 8;
                                       -fx-font-size: 14;
                                   "/>

                        <Button text="Search"
                                onAction="#handleSearch"
                                style="
                                    -fx-background-color: #00c6ff;
                                    -fx-text-fill: white;
                                    -fx-font-weight: bold;
                                    -fx-background-radius: 8;
                                    -fx-padding: 8 16;
                                    -fx-cursor: hand;
                                "/>
                    </HBox>

                    <!-- Maps list -->
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                style="-fx-background-color: transparent;
                                       -fx-background: transparent;">

                        <VBox fx:id="mapList"
                              spacing="14"
                              style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="10"
                                        right="10"
                                        bottom="10"
                                        left="10"/>
                            </padding>
                        </VBox>

                    </ScrollPane>

                </VBox>
            </StackPane>

        </Group>
    </StackPane>

</AnchorPane>