<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.catalogPublic.GuestCatalogController"
            prefWidth="600"
            prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">


    <Button text="✕"
            onAction="#handleClose"
            AnchorPane.topAnchor="16"
            AnchorPane.rightAnchor="16"
            style="
                -fx-background-color: transparent;
                -fx-text-fill: white;
                -fx-font-size: 20;
                -fx-font-weight: bold;
                -fx-cursor: hand;
            "/>

    <VBox spacing="20"
          AnchorPane.topAnchor="40"
          AnchorPane.leftAnchor="40"
          AnchorPane.rightAnchor="40"
          AnchorPane.bottomAnchor="40">

        <Label text="City Catalog"
               style="-fx-text-fill: white;">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField"
                       promptText="Search by city name, POI or description..."
                       HBox.hgrow="ALWAYS"
                       style="
                           -fx-background-radius: 8;
                           -fx-padding: 8;
                           -fx-font-size: 14;
                       "/>

            <Button text="Search"
                    onAction="#handleSearch"
                    style="
                        -fx-background-color: #00c6ff;
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                        -fx-background-radius: 8;
                        -fx-padding: 8 16;
                        -fx-cursor: hand;
                    "/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">

            <VBox fx:id="cityList"
                  spacing="14"
                  style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </VBox>

        </ScrollPane>

    </VBox>

</AnchorPane>