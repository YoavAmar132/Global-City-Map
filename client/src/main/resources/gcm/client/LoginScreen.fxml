<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.LoginController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <!-- Close (X) button -->
    <Button text="✕"
            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;"
            onAction="#handleClose"
            AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>

    <!-- Center card -->
    <StackPane prefWidth="400.0" prefHeight="260.0"
               layoutX="100.0" layoutY="70.0"
               style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <effect>
            <DropShadow radius="10.0" color="#00000055"/>
        </effect>

        <VBox alignment="CENTER" spacing="15.0" prefWidth="300.0">
            <!-- Headline -->
            <Text text="Global City Map" fill="white">
                <font>
                    <Font name="Segoe UI Semibold" size="30.0" />
                </font>
            </Text>

            <!-- Username -->
            <VBox spacing="5.0">
                <Label text="Username" textFill="white" style="-fx-font-size: 14;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.9); -fx-padding: 8 10;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="5.0">
                <Label text="Password" textFill="white" style="-fx-font-size: 14;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.9); -fx-padding: 8 10;"/>
            </VBox>

            <!-- Login button -->
            <Button fx:id="loginButton" text="Log In"
                    prefWidth="160.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-font-size: 15; -fx-background-radius: 8; -fx-cursor: hand;"
                    onAction="#onLoginClicked"/>
            <!-- Register button -->
            <Button fx:id="registerButton" text="Register Now"
                    prefWidth="200.0" prefHeight="26.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-font-size: 15; -fx-background-radius: 8; -fx-cursor: hand;"
                    onAction="#onRegisterClicked"/>
        </VBox>
    </StackPane>
</AnchorPane>
