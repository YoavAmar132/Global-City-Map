<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gcm.client.controllers.UserMenuController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <!-- Close (X) button -->
    <Button text="✕"
            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;"
            onAction="#handleClose"
            AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"/>

    <!-- Center card -->
    <StackPane prefWidth="400.0" prefHeight="260.0"
               layoutX="100.0" layoutY="70.0"
               style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <effect>
            <DropShadow radius="10.0" color="#00000055"/>
        </effect>

        <VBox alignment="CENTER" spacing="15.0" prefWidth="300.0">
            <!-- Headline -->
            <Text text="Global City Map" fill="white">
                <font>
                    <Font name="Segoe UI Semibold" size="30.0" />
                </font>
            </Text>

            <!-- Subtitle -->
            <Label text="User Menu"
                   textFill="white"
                   style="-fx-font-size: 16;"/>

            <!-- View Catalog button -->
            <Button fx:id="viewCatalogButton" text="View Catalog"
                    prefWidth="200.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                    onAction="#onViewCatalogClicked"/>

            <!-- Buy a Map button -->
            <Button fx:id="buyMapButton" text="Buy a Map"
                    prefWidth="200.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                    onAction="#onBuyMapClicked"/>

            <!-- My Maps button -->
            <Button fx:id="myMapsButton" text="My Maps"
                    prefWidth="200.0" prefHeight="36.0"
                    style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                    onAction="#onMyMapsClicked"/>

        </VBox>
    </StackPane>
</AnchorPane>
