<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>gcm</groupId>
    <artifactId>Global_City_map</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>client</module>
        <module>server</module>
        <module>tests</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- keep your JavaFX version -->
        <javafx.version>21.0.4</javafx.version>

        <!-- ADD: TestFX + Surefire versions -->
        <testfx.version>4.0.18</testfx.version>
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <!-- ADD: surefire configuration for JavaFX + TestFX on Java 21 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!-- avoids module-path issues with TestFX -->
                        <useModulePath>false</useModulePath>

                        <!-- REQUIRED for TestFX on Java 21 -->
                        <argLine>
                            --add-modules javafx.controls,javafx.fxml
                            --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                            --add-opens javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED
                            --add-opens javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
