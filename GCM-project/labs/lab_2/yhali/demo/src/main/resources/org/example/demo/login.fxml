<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="161.0" prefWidth="322.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.LoginController">
   <children>
      <Label layoutX="14.0" layoutY="23.0" text="Username:">
         <font>
            <Font name="Arial" size="23.0" />
         </font>
      </Label>
      <TextField fx:id="usernameField" layoutX="136.0" layoutY="24.0" />
      <Label layoutX="14.0" layoutY="68.0" text="Password:">
         <font>
            <Font name="Arial" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="passwordField" layoutX="136.0" layoutY="68.0" />
      <Button layoutX="136.0" layoutY="111.0" mnemonicParsing="false" onAction="#handleLogin" text="Login" />
      <Button layoutX="263.0" layoutY="111.0" mnemonicParsing="false" onAction="#handleExit" text="Exit" />
   </children>
</AnchorPane>
